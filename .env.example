DATABASE_URL="postgresql://usuario@localhost:5432/calendario_adviento_dev?schema=public"

# Auth.js — ver docs/auth.md
AUTH_SECRET="genera uno con: npx auth secret"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo local/desarrollo: activa un login simulado (sin Google) en /login.
# Nunca se activa aunque esté en true si NODE_ENV=production.
AUTH_DEV_LOGIN=true

# Emails que se marcan isSuperAdmin=true la primera vez que inician sesión
# (bootstrap del primer Super Admin — ver docs/auth.md).
SUPER_ADMIN_EMAILS=
