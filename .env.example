# Convex (TAL-9/10) — las genera `npx convex dev` en .env.local en local;
# en Railway van como variables del servicio (ver docs/stack.md § "Qué
# cambia en el despliegue de Railway"). Obligatoria para habilitar Convex,
# no para arrancar la app: sin ella, ConvexClientProvider no monta el
# ConvexProvider (ver src/components/convex-client-provider.tsx) — la app
# arranca igual, pero nada de lo que dependa de Convex funcionará.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# TAL-11 — secreto compartido entre este servidor de Next.js y el
# deployment de Convex (ver docs/auth.md § "Frontera pública de Convex" y
# convex/serverAuth.ts). Variable de SERVIDOR, nunca `NEXT_PUBLIC_*` — si
# lo fuera, llegaría al navegador y cualquiera podría invocar las
# funciones "delgadas" de Convex saltándose Next.js por completo. Debe
# coincidir EXACTAMENTE con la variable del mismo nombre en el deployment
# de Convex (`npx convex env set CONVEX_APP_SERVER_SECRET <valor>`) — son
# dos variables independientes en dos sistemas distintos que tienen que
# llevar el mismo valor a mano; nada las sincroniza automáticamente.
# Genera un valor con: openssl rand -hex 32
CONVEX_APP_SERVER_SECRET=

# Auth.js — ver docs/auth.md
AUTH_SECRET="genera uno con: npx auth secret"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo local/desarrollo: activa un login simulado (sin Google) en /login.
# Nunca se activa aunque esté en true si NODE_ENV=production.
AUTH_DEV_LOGIN=true

# Emails que se marcan isSuperAdmin=true la primera vez que inician sesión
# (bootstrap del primer Super Admin — ver docs/auth.md). TAL-11 reactiva su
# consumidor (src/lib/auth.ts) contra Convex — dormida solo entre TAL-10 y
# TAL-11, no huérfana.
SUPER_ADMIN_EMAILS=

# Origen canónico de la app (sin barra final), p. ej. https://mi-app.up.railway.app
# En producción, obligatorio para que el link de invitación (TAL-7,
# docs/invitados.md) no confíe en el header Host, que un proxy mal
# configurado podría dejar pasar con un valor arbitrario. En local no hace
# falta: si no está definido, se usa localhost/127.0.0.1 del propio Host.
APP_URL=
